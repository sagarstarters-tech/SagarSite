# ============================================================
#  STORE — Environment Configuration Template
# ============================================================
#  ✅ Copy this file and rename it to ".env"
#  ✅ Fill in your real database, domain and email credentials
#  ⛔ Never commit your real ".env" file to Git/version control!
# ============================================================

# Application Environment: "development" or "production"
APP_ENV=development

# ── URLs ──────────────────────────────────────────────────────
# Local XAMPP:                  SITE_URL=/store
# Hostinger root domain:        SITE_URL=https://yourdomain.com
# Hostinger subdirectory:       SITE_URL=https://yourdomain.com/shop
SITE_URL=https://yourdomain.com

# ── Database ──────────────────────────────────────────────
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password
DB_PORT=3306

# ── SMTP / Email ──────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_PORT=465
SMTP_SECURE=ssl
MAIL_FROM_NAME="Store Customer Support"

# ── Social Media Module ───────────────────────────────────
# Encryption key for OAuth tokens (generate with: php -r "echo bin2hex(random_bytes(32));")
SOCIAL_ENCRYPTION_KEY=
# Secret key for cron job HTTP access (auto-generated during migration)
SOCIAL_CRON_SECRET=

# ── Facebook connect ──────────────────────────────────────
FB_APP_ID=
FB_APP_SECRET=

# ── Linkedin connect ──────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── Pinterest connect ─────────────────────────────────────
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# ── Twitter / X connect ───────────────────────────────────
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# ── Telegram (Bot Token) ──────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── Software Domain License ───────────────────────────────
# Enter the official single-domain license key provided by your vendor
LICENSE_KEY=
