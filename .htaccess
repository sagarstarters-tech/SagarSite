RewriteEngine On
# RewriteBase /

# ══════════════════════════════════════════════════════════════
# 0. WHITELIST SOCIAL MEDIA CRAWLERS (bypass any WAF/firewall)
# ══════════════════════════════════════════════════════════════
<IfModule mod_setenvif.c>
    SetEnvIf User-Agent "facebookexternalhit" allowed_bot
    SetEnvIf User-Agent "Facebot" allowed_bot
    SetEnvIf User-Agent "WhatsApp" allowed_bot
</IfModule>

<IfModule mod_security.c>
    SecFilterEngine Off
    SecFilterScanPOST Off
</IfModule>
<IfModule mod_security2.c>
    SecRuleEngine Off
</IfModule>


# ══════════════════════════════════════════════════════════════
# 1. FORCE HTTPS AND WWW IN A SINGLE CANONICAL HOP
# ══════════════════════════════════════════════════════════════
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTP_HOST} ^(?!www\.)(.+)$ [NC,OR]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://www.%1%{REQUEST_URI} [L,R=301]

# ══════════════════════════════════════════════════════════════
# 3. SECURITY — Block sensitive files
# ══════════════════════════════════════════════════════════════

# Block .env files
<FilesMatch "^\.env(\..*)? $">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block all debug/test/setup PHP files at root
<FilesMatch "^(debug_db|debug_pdo|debug_schema|debug_verify_fix|check_schema|test_optimize|verify_fix|verify_scripts|db_setup_scripts|tmp_check_admin)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block Git / composer / config files
<FilesMatch "(^#.*#|\.(bak|conf|config|dist|fla|inc|ini|log|sh|sql|swp)|~)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ══════════════════════════════════════════════════════════════
# 4. DISABLE DIRECTORY BROWSING
# ══════════════════════════════════════════════════════════════
Options -Indexes

# ══════════════════════════════════════════════════════════════
# 5. SECURITY HEADERS (Apache 2.4+)
# ══════════════════════════════════════════════════════════════
<IfModule mod_headers.c>
    # Prevent Clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"
    # Prevent XSS
    Header always set X-XSS-Protection "1; mode=block"
    # Prevent MIME sniffing
    Header always set X-Content-Type-Options "nosniff"
    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Remove server version info
    Header unset X-Powered-By
    Header always unset X-Powered-By
    # HSTS — Uncomment on live with SSL only
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    # Content Security Policy (basic, adjust as needed for live)
    # Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdnjs.cloudflare.com https://code.jquery.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; img-src 'self' data:; font-src 'self' https://cdnjs.cloudflare.com;"
</IfModule>

# ══════════════════════════════════════════════════════════════
# 6. GZIP + BROTLI COMPRESSION
# ══════════════════════════════════════════════════════════════
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE application/font-woff
    AddOutputFilterByType DEFLATE application/font-woff2
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
    # Don't compress already-compressed types
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|ico)$ no-gzip dont-vary
</IfModule>

# Brotli compression (Hostinger & LiteSpeed support)
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css
    AddOutputFilterByType BROTLI_COMPRESS application/javascript application/x-javascript
    AddOutputFilterByType BROTLI_COMPRESS application/json image/svg+xml
    AddOutputFilterByType BROTLI_COMPRESS font/woff2 font/woff
</IfModule>

# ══════════════════════════════════════════════════════════════
# 7. BROWSER CACHING — Long cache for versioned assets
# ══════════════════════════════════════════════════════════════
<IfModule mod_expires.c>
    ExpiresActive On
    # Images — 1 year
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    # CSS & JS — 1 year (safe because files use ?v= versioning for cache-busting)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    # Fonts — 1 year
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/json "access plus 1 hour"
    # HTML/PHP — no cache (dynamic content)
    ExpiresByType text/html "access plus 0 seconds"
    # Default
    ExpiresDefault "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
    # Serve correct Vary header for compressed content
    Header append Vary Accept-Encoding

    # CSS/JS — 1 year, immutable (versioned via ?v= params)
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # Images — 1 year, immutable
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|ico|svg|avif)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # Fonts — 1 year
    <FilesMatch "\.(woff|woff2|ttf|otf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # HTML/PHP — no cache
    <FilesMatch "\.(php|html)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    # Enable HSTS on HTTPS
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# ══════════════════════════════════════════════════════════════
# 8. CUSTOM ERROR PAGES
# ══════════════════════════════════════════════════════════════
ErrorDocument 404 /404.php
ErrorDocument 500 /500.php
ErrorDocument 403 /404.php

# ══════════════════════════════════════════════════════════════
# 9. URL REWRITE RULES
# ══════════════════════════════════════════════════════════════

# Image 404 Fallback to prevent broken images
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^assets/images/.*\.(jpe?g|png|gif|webp|svg)$ assets/images/placeholder.svg [L,NC]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^uploads/.*\.(jpe?g|png|gif|webp|svg)$ assets/images/placeholder.svg [L,NC]

# Dynamic sitemap
RewriteRule ^sitemap\.xml$ sitemap.php [L,QSA]

# Product SEF URL
RewriteRule ^product/([^/]+)/?$ product.php?slug=$1 [L,QSA]

# Category SEF URL
RewriteRule ^category/([^/]+)/?$ shop.php?category_slug=$1 [L,QSA]

# Page SEF URL
RewriteRule ^page/([^/]+)/?$ page.php?slug=$1 [L,QSA]

# Order tracking SEF URL (optional)
# RewriteRule ^track/([^/]+)/([^/]+)/?$ track_order.php?order_id=$1&email=$2 [L,QSA]

# ══════════════════════════════════════════════════════════════
# 10. BLOCK BAD BOTS & SCANNERS (whitelist social crawlers first)
# ══════════════════════════════════════════════════════════════
<IfModule mod_rewrite.c>
    # Allow Facebook & WhatsApp crawlers (needed for OG image previews)
    RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|WhatsApp) [NC]
    RewriteRule .* - [L]

    # Allow curl requests to /cron/ path (Hostinger cron jobs use curl)
    RewriteCond %{REQUEST_URI} ^/cron/ [NC]
    RewriteRule .* - [L]

    RewriteCond %{HTTP_USER_AGENT} (libwww-perl|wget|python|nikto|curl|scan|java|winhttp|clshttp|loader) [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} (<|>|'|%0A|%0D|%27|%3C|%3E|%00) [NC]
    RewriteRule .* - [F,L]
</IfModule>
