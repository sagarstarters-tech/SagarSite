# ============================================================
#  STORE — Environment Configuration Template
# ============================================================
#  Copy this file to .env and fill in your real credentials.
#  This .env.example file is SAFE to commit to version control.
# ============================================================

# Application Environment: "development" or "production"
APP_ENV=development

# ── URLs ──────────────────────────────────────────────────────
# Local XAMPP:                  SITE_URL=/store
# Hostinger root domain:        SITE_URL=https://jevarmart.com
# Hostinger subdirectory:       SITE_URL=/yourfolder
SITE_URL=https://jevarmart.com

# ── Database ──────────────────────────────────────────────
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password
DB_PORT=3306

# ── SMTP / Email ──────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_PORT=465
SMTP_SECURE=ssl
MAIL_FROM_NAME=Your Store Name

# ── Social Media Module ───────────────────────────────────
# Encryption key for OAuth tokens (generate with: php -r "echo bin2hex(random_bytes(32));")
SOCIAL_ENCRYPTION_KEY=
# Secret key for cron job HTTP access (auto-generated during migration)
SOCIAL_CRON_SECRET=

# Facebook / Instagram (Meta)
FB_APP_ID=
FB_APP_SECRET=

# X (Twitter)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Pinterest
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# Telegram (Bot Token — get from @BotFather)
TELEGRAM_BOT_TOKEN=
