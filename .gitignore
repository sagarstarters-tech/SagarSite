# Environment files
.env
.env.local
.env.*.local

# XAMPP/Local stuff
/tmp/
/logs/
*.log
Thumbs.db
.DS_Store

# Prevent Git from tracking or modifying user-uploaded images in assets/images/
/assets/images/*
!/assets/images/.gitkeep
!/assets/images/placeholder.svg
!/assets/images/placeholder.png
!/assets/images/no-image.png
!/assets/images/google-icon.svg

# User Uploads Directory Protection (git-ignored)
/uploads/*
!/uploads/.gitkeep
!/uploads/.gitignore

# Vendor (if composer is used)
# Backups & SQL Dumps
*.sql
*.zip
*.tar.gz
*.7z
/backups/
/backup/
/scratch/
scratch.php




