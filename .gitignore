# Environment files
.env
.env.local
.env.*.local

# XAMPP/Local stuff
/tmp/
/logs/
*.log
Thumbs.db
.DS_Store

# Allow essential site icons, slider images, and default media in assets/images/
/assets/images/*
!/assets/images/.gitkeep
!/assets/images/*.svg
!/assets/images/*.png
!/assets/images/*.jpg
!/assets/images/*.jpeg
!/assets/images/*.webp
!/assets/images/*.ico
!/assets/images/slider/
!/assets/images/slider/*
!/assets/images/features/
!/assets/images/features/*
!/assets/images/testimonials/
!/assets/images/testimonials/*

# User Uploads Directory Protection (NEVER tracked by git → deploy-safe)
# The uploads/ directory is intentionally excluded from git so that
# admin-uploaded images are NEVER wiped when Hostinger does a git deployment.
/uploads/*
!/uploads/.gitkeep
!/uploads/.gitignore
!/uploads/downloads/.htaccess
!/uploads/images/
!/uploads/images/.gitkeep
!/uploads/images/.htaccess
!/uploads/images/profile/
!/uploads/images/profile/.gitkeep

# Vendor (if composer is used)
# Backups & SQL Dumps
*.sql
*.zip
*.tar.gz
*.7z
/backups/
/backup/
/scratch/
scratch.php




